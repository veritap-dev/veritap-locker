{
  "name": "veritap-locker",
  "version": "0.1.0",
  "private": true,
  "description": "Wallet-addressed mailbox & storage for agents. The wallet is the account.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply veritap_locker --local",
    "db:migrate:remote": "wrangler d1 migrations apply veritap_locker --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "viem": "^2.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.2.0",
    "blakejs": "^1.2.1",
    "fast-check": "^4.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.120.1",
    "x402-fetch": "^1.2.0"
  }
}
